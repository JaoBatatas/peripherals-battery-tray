# Logitech G435 Wireless Headset
KERNEL=="hidraw*", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0acb", MODE="0660", TAG+="uaccess"

# Redragon King Pro 1K (2.4GHz Dongle + Wired USB)
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f5d5", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f55e", MODE="0660", TAG+="uaccess"

# Allow passive wake-up event reading for Redragon King Pro 1K
SUBSYSTEM=="input", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f5d5", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="input", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f55e", MODE="0660", TAG+="uaccess"
